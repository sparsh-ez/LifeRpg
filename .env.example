# Life RPG - Environment Variables
# Copy this file to .env.local and fill in your Supabase credentials

# Supabase Project URL and Public Anon Key (from Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Supabase Service Role Key (Used for server-side admin actions, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder

# Public site URL for authentication redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000
